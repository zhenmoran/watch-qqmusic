<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网部署走 http，需显式放行明文；生产建议给服务器配 https 后关掉 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
